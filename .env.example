# Copy this file to .env and fill in your own values.

# MongoDB (local is the default; Atlas is optional)
MONGO_URI=mongodb://localhost:27017
# Only needed if you want fallback to a hosted cluster when local Mongo is down.
# Leave MONGO_URI_ATLAS empty to disable the Atlas fallback.
MONGO_URI_ATLAS=your_mongodb_atlas_connection_string_here
MONGO_DB_NAME=spotify_friends
MONGO_COLLECTION=friends_activity

# Optional WhatsApp bridge
WHATSAPP_API_PORT=3939
WHATSAPP_API_URL=http://localhost:3939/spotify

# Flask server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Fetch loop interval (seconds)
ACTIVITY_INTERVAL=60